# Copy this file to .env and fill in the values.
# .env is git-ignored: never commit real keys.

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM (provider-agnostic) ---
# Supported providers: ollama | openai
LLM_PROVIDER=ollama
# Initial candidate; compared against alternatives in Phase 4
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Only needed by providers that require a key (e.g. openai). Leave empty for ollama.
LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_PROVIDER=sentence_transformers
# Initial candidate; final choice after the Phase 3 retrieval benchmark
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- RAG ---
VECTOR_DB_PATH=data/vectorstore
RAG_TOP_K=5

# --- Machine learning ---
MODEL_DIR=models
MODEL_VERSION=1.0.0
# Positive label = failure within the next N operating cycles
FAILURE_HORIZON_CYCLES=30

# --- Relational store ---
DATABASE_URL=sqlite:///data/equipment.db
