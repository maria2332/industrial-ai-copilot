# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtual environments ---
.venv/
venv/

# --- Secrets: never commit real environment files ---
.env
.env.*
!.env.example

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/

# --- Data: downloaded or generated, never committed ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/documents/pdf/*
!data/documents/pdf/.gitkeep
data/vectorstore/
*.db

# --- Trained model artifacts ---
models/*
!models/.gitkeep

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
